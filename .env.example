# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored -- NEVER commit real keys.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- OpenAI (REQUIRED) -----------------------------------------------------
# Billed by OpenAI, NOT by Google. Your GCP trial credits do not pay for this.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-me

# gpt-4o-mini is ~17x cheaper than gpt-4o. Do not change without a reason.
CHAT_MODEL=gpt-4o-mini
# Point at any OpenAI-compatible endpoint (a proxy, or a local server). Empty
# uses api.openai.com.
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=30
# Retries are on top of the timeout, so worst-case latency is roughly
# timeout x (retries + 1). Keep both small: Cloud Run bills for wall time.
OPENAI_MAX_RETRIES=2
EMBEDDING_MODEL=text-embedding-3-small
MAX_OUTPUT_TOKENS=512
TEMPERATURE=0.2

# --- Service ---------------------------------------------------------------
SERVICE_NAME=llmops-rag-api
LOG_LEVEL=INFO
# Cloud Run injects PORT automatically; only needed for local runs.
PORT=8080

# Your GCP project id. Used to format Cloud Logging trace fields.
GCP_PROJECT_ID=

# Optional shared secret for /ingest and /query. Leave empty to disable auth.
# STRONGLY recommended once deployed publicly: an open endpoint lets strangers
# spend your OpenAI balance.
APP_API_KEY=

# --- Retrieval -------------------------------------------------------------
# On Cloud Run use /tmp (the only writable path). It is in-memory and
# per-instance, so ingested data survives a scale-to-zero only via the GCS
# snapshot below -- set GCS_BUCKET or accept that it does not.
# Rejects a single oversized document before it is chunked and embedded --
# embedding a large upload is the most expensive thing this service does.
MAX_INGEST_CHARS=200000
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=documents
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
# Absolute floor: does this query match the corpus at all? Calibrated on real
# embeddings; see "Why the floor stops here" in the README before changing it.
MIN_SIMILARITY=0.28
# Relative floor: given what this query matched, is this chunk one of the good
# ones? Drops chunks below this fraction of the best hit. Cuts ~27% of input
# tokens on every query. 0 disables.
MIN_SIMILARITY_RATIO=0.60

# --- MLflow ----------------------------------------------------------------
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=sqlite:///./data/mlflow.db
MLFLOW_EXPERIMENT=llmops-rag-demo
# GCS bucket for artifacts, e.g. gs://my-project-mlflow-artifacts/mlflow
# Leave empty to keep artifacts on the local filesystem (zero GCP cost).
MLFLOW_ARTIFACT_LOCATION=
MLFLOW_LOG_ARTIFACTS=true
# The tracking DB is snapshotted to GCS so `make drift` can see production --
# without this it dies with the instance. One object per process under this
# prefix: a shared object would have instances overwriting each other's runs.
MLFLOW_SNAPSHOT_PREFIX=snapshots/mlflow/
# One upload per this many runs, not one per run: GCS allows 5,000 free class A
# operations a month. 0 disables.
MLFLOW_SNAPSHOT_EVERY=25
# How many shards `make drift` merges when reading.
MLFLOW_SNAPSHOT_MAX_SHARDS=50

# --- Cost display ----------------------------------------------------------
# Only used to render the rupee figure alongside the USD estimate.
USD_TO_INR=88.0

# ---------------------------------------------------------------------------
# Durability (optional)
# ---------------------------------------------------------------------------
# Cloud Run's /tmp is an in-memory tmpfs, private to one instance and lost on
# scale-to-zero. Set this to a GCS bucket to snapshot the Chroma store there
# after each ingest and restore it on cold start. Leave empty locally, where
# the filesystem is already durable.
GCS_BUCKET=
CHROMA_SNAPSHOT_OBJECT=snapshots/chroma.tar.gz
SNAPSHOT_ON_INGEST=true

# ---------------------------------------------------------------------------
# Spend and abuse ceilings
# ---------------------------------------------------------------------------
# Hard cap on estimated OpenAI spend per rolling 24h, enforced in-process.
# GCP teardown does not stop the OpenAI bill; this is what bounds it.
# 0 disables. ~1,200 gpt-4o-mini queries fit inside $0.25.
DAILY_BUDGET_USD=0.25
# Per-client requests per minute on /ingest and /query. 0 disables.
RATE_LIMIT_PER_MINUTE=30
